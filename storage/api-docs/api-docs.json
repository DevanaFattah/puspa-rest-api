{
    "openapi": "3.0.0",
    "info": {
        "title": "Puspa Holistic Integrative Care API",
        "description": "Dokumentasi Swagger OpenAPI v2 untuk aplikasi Puspa Holistic Integrative Care",
        "version": "2.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000/api/v1",
            "description": "Local Development API Server"
        }
    ],
    "paths": {
        "/schedules": {
            "get": {
                "tags": [
                    "Schedules"
                ],
                "summary": "Mengambil daftar master jadwal terapi (with filters & pagination)",
                "operationId": "bdea5ade44d91a49b037f3ccab7910be",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Halaman paginasi",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Jumlah per halaman",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "day_of_week",
                        "in": "query",
                        "description": "Filter hari (1=Senin..7=Minggu)",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Filter status (aktif, non_aktif, selesai)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "therapy_type",
                        "in": "query",
                        "description": "Filter jenis terapi (okupasi, fisio, wicara, paedagog)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Cari nama anak, RM, atau nama wali",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Daftar Master Jadwal Terapi"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Schedules"
                ],
                "summary": "Membuat master jadwal baru (Otomatis me-generate sesi pertemuan)",
                "operationId": "68f4ee66ee292663799d2d3cffaed608",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "child_id",
                                    "therapist_id",
                                    "therapy_type",
                                    "day_of_week",
                                    "start_time",
                                    "end_time",
                                    "total_meetings",
                                    "period_start",
                                    "period_end"
                                ],
                                "properties": {
                                    "child_id": {
                                        "type": "string",
                                        "example": "01M3P024T4DF062NCEJZXFZEH1"
                                    },
                                    "therapist_id": {
                                        "type": "string",
                                        "example": "01M3P024T4DF062NCEJZXFZEH2"
                                    },
                                    "therapy_type": {
                                        "type": "string",
                                        "example": "paedagog"
                                    },
                                    "day_of_week": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "start_time": {
                                        "type": "string",
                                        "example": "15:30"
                                    },
                                    "end_time": {
                                        "type": "string",
                                        "example": "16:30"
                                    },
                                    "total_meetings": {
                                        "type": "integer",
                                        "example": 4
                                    },
                                    "period_start": {
                                        "type": "string",
                                        "example": "2026-10-05"
                                    },
                                    "period_end": {
                                        "type": "string",
                                        "example": "2026-11-05"
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "aktif"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Berhasil menambahkan jadwal baru"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/schedules/{schedule}": {
            "get": {
                "tags": [
                    "Schedules"
                ],
                "summary": "Mengambil detail master jadwal beserta sesi pertemuan",
                "operationId": "8c1b48c006db3aa00cfec0f7c780b786",
                "parameters": [
                    {
                        "name": "schedule",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Detail Master Jadwal Terapi"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Schedules"
                ],
                "summary": "Memperbarui data master jadwal",
                "operationId": "d9266123f607bcc1d263a2bb5d092c4c",
                "parameters": [
                    {
                        "name": "schedule",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "day_of_week": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "start_time": {
                                        "type": "string",
                                        "example": "16:00"
                                    },
                                    "end_time": {
                                        "type": "string",
                                        "example": "17:00"
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "aktif"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Berhasil memperbarui jadwal"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Schedules"
                ],
                "summary": "Menghapus master jadwal dan seluruh sesinya",
                "operationId": "d8585d8c2fd9d255be9a674b4671c24d",
                "parameters": [
                    {
                        "name": "schedule",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Berhasil menghapus jadwal"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Schedules",
            "description": "API Endpoints untuk Pengelolaan Master Jadwal Terapi Anak"
        }
    ]
}